{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Jeston",
  "description": "The React-first full-stack framework by Hedron.",
  "theme": "maple",
  "colors": {
    "primary": "#000000",
    "dark": "#000000",
    "light": "#Ffffff"
  },
  "logo": {
    "light": "/path/to/docs/images/6002.png",
    "dark": "/path/to/docs/images/6003.png",
    "href": "https://github.com/jeffersoncampos12p-dev/jeston"
  },
  "favicon": {
    "light": "/path/to/docs/images/6003.png",
    "dark": "/path/to/docs/images/6002.png"
  },
  "topbarLinks": [
    { "name": "GitHub", "url": "https://github.com/jeffersoncampos12p-dev/jeston" },
    { "name": "npm", "url": "https://www.npmjs.com/package/@hedronjs/jeston" }
  ],
  "footerSocials": { "github": "https://github.com/jeffersoncampos12p-dev/jeston" },
  "navigation": {
    "groups": [
      { "group": "Start", "pages": ["index", "start/installation", "start/first-app", "start/saas-starter"] },
      { "group": "Core", "pages": ["core/architecture", "core/react-ssr", "core/routing", "core/api-routes", "core/configuration"] },
      { "group": "Platform", "pages": ["platform/sql", "platform/auth", "platform/security", "platform/cache-jobs-storage", "platform/health-observability"] },
      { "group": "Reference", "pages": ["reference/types", "reference/cli", "reference/adapters", "reference/compatibility"] },
      { "group": "Operations", "pages": ["operations/deployment", "operations/production", "operations/migrations", "operations/benchmark"] }
    ],
    "global": {
      "dropdowns": [
        {
          "dropdown": "View in npm",
          "href": "https://www.npmjs.com/package/@hedronjs/jeston",
          "icon": "npm",
          "description": "Install npm and create a website."
        },
        {
          "dropdown": "Latest Release",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston/releases/latest"
        }
      ],
      "anchors": [
        {
          "anchor": "View on Github",
          "icon": "github",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston"
        },
        {
          "anchor": "Operation status",
          "icon": "route-interstate",
          "href": "https://pagein.com"
        }
      ],
      "versions": [
        {
          "version": "Version 1.0.1 available",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston/releases/tag/v1.0.1"
        },
        {
          "version": "Version 1.0.2 under development",
          "href": "https://www.npmjs.com/package/@hedronjs/jeston/1.0.2",
          "default": true
        }
      ]
    }
  },
  "icons": { "library": "fontawesome" },
  "navbar": {
    "links": [
      {
        "href": "/integrations",
        "label": "Integrations"
      }
    ]
  },
  "styling": { "eyebrows": "breadcrumbs" },
  "interaction": { "drilldown": true },
  "api": { "examples": { "prefill": true, "autogenerate": true } },
  "markdown": { "schema": true },
  "background": {
    "color": {
      "dark": "#000000",
      "light": "#Ffffff"
    }
  },
  "appearance": { "strict": false }
}
