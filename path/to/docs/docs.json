{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Jeston by Kvant",
  "description": "Complete Jeston documentation by Kvant: a React-first full-stack TypeScript framework for deterministic APIs, SSR, streaming, SQL, authentication, jobs, observability, AI agents, integrations, and portable production systems.",
  "theme": "sequoia",
  "colors": {
    "primary": "#141414",
    "dark": "#1c1c1c",
    "light": "#F5f5f5"
  },
  "logo": {
    "light": "/path/to/docs/images/6263.png",
    "dark": "/path/to/docs/images/6264.png",
    "href": "https://github.com/jeffersoncampos12p-dev/jeston"
  },
  "favicon": {
    "light": "/path/to/docs/images/6261.png",
    "dark": "/path/to/docs/images/6262.png"
  },
  "topbarLinks": [
    {
      "name": "GitHub",
      "url": "https://github.com/jeffersoncampos12p-dev/jeston"
    },
    {
      "name": "npm",
      "url": "https://www.npmjs.com/package/@kvantjs/jeston"
    },
    {
      "name": "Changelog",
      "url": "https://github.com/jeffersoncampos12p-dev/jeston/blob/main/CHANGELOG.md"
    },
    {
      "name": "Issues",
      "url": "https://github.com/jeffersoncampos12p-dev/jeston/issues"
    }
  ],
  "footerSocials": {
    "github": "https://github.com/jeffersoncampos12p-dev/jeston"
  },
  "navigation": {
    "global": {
      "dropdowns": [
        {
          "dropdown": "View in npm",
          "href": "https://www.npmjs.com/package/@kvantjs/jeston",
          "icon": "npm",
          "description": "Inspect the published package metadata."
        },
        {
          "dropdown": "Project resources",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston",
          "icon": "github",
          "description": "Source code, issues, releases, roadmap, and contribution history."
        }
      ],
      "anchors": [
        {
          "anchor": "View on GitHub",
          "icon": "github",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston"
        },
        {
          "anchor": "Report an issue",
          "icon": "bug",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston/issues/new"
        },
        {
          "anchor": "Release notes",
          "icon": "book-open",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston/blob/main/CHANGELOG.md"
        }
      ]
    },
    "pages": [
      {
        "group": "Start",
        "pages": [
          "index",
          "start/installation",
          "start/first-app",
          "start/saas-starter"
        ]
      },
      {
        "group": "Core",
        "pages": [
          "core/architecture",
          "core/react-ssr",
          "core/routing",
          "core/api-routes",
          "core/configuration",
          "core/execution-and-streaming",
          "core/react-server-components"
        ]
      },
      {
        "group": "Platform",
        "pages": [
          "platform/sql",
          "platform/auth",
          "platform/security",
          "platform/cache-jobs-storage",
          "platform/health-observability",
          "platform/ai-agents"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/types",
          "reference/cli",
          "reference/http-contracts",
          "reference/adapters",
          "reference/compatibility",
          "reference/integrations"
        ]
      },
      {
        "group": "Operations",
        "pages": [
          "operations/deployment",
          "operations/production",
          "operations/migrations",
          "operations/benchmark",
          "operations/jobs-and-shutdown",
          "operations/release-checks",
          "operations/ecosystem"
        ]
      },
      "deprecated-versions"
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "latex": true,
    "eyebrows": "section"
  },
  "interaction": {
    "drilldown": true
  },
  "markdown": {
    "schema": true
  },
  "background": {
    "color": {
      "light": "#F8FAFC",
      "dark": "#0B0C0E"
    }
  },
  "appearance": {
    "strict": false,
    "default": "light"
  },
  "contextual": {
    "options": [
      "vscode",
      "cursor",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kvantjs/ryvax.js"
    },
