{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Jeston",
  "description": "The React-first full-stack TypeScript framework by Hedron for deterministic APIs, streaming, jobs, and observable production systems.",
  "theme": "maple",
  "colors": {
    "primary": "#000000",
    "dark": "#000000",
    "light": "#F8FAFC"
  },
  "logo": {
    "light": "/images/6002.png",
    "dark": "/images/6003.png",
    "href": "https://github.com/jeffersoncampos12p-dev/jeston"
  },
  "favicon": {
    "light": "/images/6003.png",
    "dark": "/images/6002.png"
  },
  "topbarLinks": [
    {
      "name": "GitHub",
      "url": "https://github.com/jeffersoncampos12p-dev/jeston"
    },
    {
      "name": "npm",
      "url": "https://www.npmjs.com/package/@hedronjs/jeston"
    }
  ],
  "footerSocials": {
    "github": "https://github.com/jeffersoncampos12p-dev/jeston"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "start/installation",
          "start/first-app",
          "start/saas-starter"
        ]
      },
      {
        "group": "Core",
        "pages": [
          "core/architecture",
          "core/react-ssr",
          "core/routing",
          "core/api-routes",
          "core/configuration",
          "core/execution-and-streaming"
        ]
      },
      {
        "group": "Platform",
        "pages": [
          "platform/sql",
          "platform/auth",
          "platform/security",
          "platform/cache-jobs-storage",
          "platform/health-observability"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/types",
          "reference/cli",
          "reference/http-contracts",
          "reference/adapters",
          "reference/compatibility"
        ]
      },
      {
        "group": "Operations",
        "pages": [
          "operations/deployment",
          "operations/production",
          "operations/migrations",
          "operations/benchmark",
          "operations/jobs-and-shutdown",
          "operations/release-checks"
        ]
      }
    ],
    "global": {
      "dropdowns": [
        {
          "dropdown": "View in npm",
          "href": "https://www.npmjs.com/package/@hedronjs/jeston",
          "icon": "npm",
          "description": "Inspect the published package metadata."
        }
      ],
      "anchors": [
        {
          "anchor": "View on GitHub",
          "icon": "github",
          "href": "https://github.com/jeffersoncampos12p-dev/jeston"
        }
      ]
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "interaction": {
    "drilldown": true
  },
  "markdown": {
    "schema": true
  },
  "background": {
    "color": {
      "dark": "#000000",
      "light": "#F8FAFC"
    }
  },
  "appearance": {
    "strict": false,
    "default": "light"
  },
  "contextual": {
    "options": [
      "vscode",
      "cursor",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jeffersoncampos12p-dev/jeston"
    },
    "links": [
      {
        "header": "Jeston",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/jeffersoncampos12p-dev/jeston"
          },
          {
            "label": "npm",
            "href": "https://www.npmjs.com/package/@hedronjs/jeston"
          }
        ]
      }
    ]
  }
}
